# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model selection (Recommended: gemini-1.5-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Server Port
PORT=5000

# Optional: Google Maps JavaScript API Key (If omitted, uses built-in OpenStreetMap/Leaflet fallback)
VITE_GOOGLE_MAPS_API_KEY=
